{
  "version": 1,
  "about": "Sources the automatic harvester reads (scripts/harvest_sources.py), from data/v4_source_registry.json. With use_database_sources, every web source in Supabase public.sources is harvested too. Login-walled sources (X, Instagram, Facebook) can't be read automatically for free: drop screenshots into inbox/ instead. Discord is read through your own server following the official announcement channel (see SITE_SETUP.md).",
  "limits": {
    "max_pages_per_run": 20,
    "max_claims_per_page": 25,
    "max_chars_per_page": 16000
  },
